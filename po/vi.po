#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Quản lý hồ sơ hiệu suất"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD không khả dụng"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Vui lòng cài đặt asusd để quản lý hồ sơ nguồn"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Cài đặt hồ sơ nguồn"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Đóng"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Tự động chuyển hồ sơ"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Trên AC"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Trên pin"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Tên hồ sơ và biểu tượng"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Ẩn biểu tượng"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Ẩn văn bản"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Tên tùy chỉnh"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Tên biểu tượng"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Cài đặt"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Giới thiệu"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Giới thiệu về Plugin ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Phiên bản 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin để quản lý hồ sơ nguồn laptop ASUS thông qua asusd.\n"
"Cho phép chuyển đổi giữa các chế độ hiệu suất, cân bằng và yên tĩnh.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Giới hạn sạc pin ở 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Sạc đầy một lần"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Bắt đầu"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Sạc pin lên 100% một lần, bỏ qua giới hạn 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Sạc pin lên 100%% một lần?\n\n"
"Điều này sẽ tạm thời ghi đè giới hạn sạc 80%%.\n"
"Giới hạn sẽ được khôi phục sau chu kỳ sạc tiếp theo."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Không thể bắt đầu sạc đầy một lần:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Sạc đầy một lần đã bắt đầu.\n\nPin sẽ sạc lên 100%% một lần."

