msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Quản lý hồ sơ nguồn laptop ASUS thông qua asusd"

