#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Управљање профилом перформанси"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD није доступан"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Молимо инсталирајте asusd за управљање профилима напајања"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Подешавања профила напајања"

#: xfce4-asusd-battery.c
