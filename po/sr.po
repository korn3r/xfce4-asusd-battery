msgstr "_Затвори"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Аутоматско пребацивање профила"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "На струју"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "На батерију"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Називи профила и иконе"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Сакриј икону"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Сакриј текст"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Прилагођено име"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Назив иконе"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Подешавања"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "О програму"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "О ASUS Battery додатку"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Верзија 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Додатак за управљање профилима напајања ASUS лаптопова преко asusd.\n"
"Омогућава пребацивање између режима перформанси, избалансираног и тихог.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Ограничи пуњење батерије на 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Једнократно пуно пуњење"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Покрени"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Напуни батерију до 100% једном, занемарујући ограничење од 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Напунити батерију до 100%% једном?\n\n"
"Ово ће привремено поништити ограничење пуњења од 80%%.\n"
"Ограничење ће бити враћено после следећег циклуса пуњења."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Неуспешно покретање једнократног пуног пуњења:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Једнократно пуно пуњење је покренуто.\n\nБатерија ће се напунити до 100%% једном."

