#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Urus profil prestasi"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD tidak tersedia"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Sila pasang asusd untuk mengurus profil kuasa"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Tetapan Profil Kuasa"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Tutup"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Tukar profil automatik"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Pada AC"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Pada bateri"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Nama profil dan ikon"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Sembunyi ikon"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Sembunyi teks"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Nama tersuai"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Nama ikon"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Tetapan"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Perihal"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Perihal Plugin ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Versi 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin untuk mengurus profil kuasa komputer riba ASUS melalui asusd.\n"
"Membolehkan pertukaran antara mod prestasi, seimbang dan senyap.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Hadkan cas bateri kepada 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Cas penuh sekali"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Mula"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Cas bateri ke 100% sekali, mengabaikan had 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Cas bateri ke 100%% sekali?\n\n"
"Ini akan mengenepikan had cas 80%% buat sementara waktu.\n"
"Had akan dipulihkan selepas kitaran cas seterusnya."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Gagal memulakan cas penuh sekali:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Cas penuh sekali dimulakan.\n\nBateri akan dicas ke 100%% sekali."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Urus profil kuasa komputer riba ASUS melalui asusd"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>Penulis:</b> Deepseek and korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "Tutup"

#: xfce4-asusd-battery.c
msgid "xfce4-asusd-battery"
msgstr "xfce4-asusd-battery"
