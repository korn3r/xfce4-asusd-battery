#: src/asusd-client.c:1383 src/settings-dialog.c:1555
msgid "Error"
msgstr "Hapa"

#: src/asusd-client.c:1383
msgid "Failed to start one-shot full charge"
msgstr "Kāore i tīmata te utu kī tonu kotahi"

#: src/asusd-client.c:1389
msgid "One-shot full charge started"
msgstr "Kua tīmata te utu kī tonu kotahi"

#: src/asusd-client.c:1389
#, c-format
msgid "The battery will charge to 100% once."
msgstr "Ka utua te pākahiko ki te 100% kotahi."

#: src/main.c:134 src/main.c:182
#, c-format
msgid "Current profile: %s"
msgstr "Kōtaha o nāianei: %s"

#: src/main.c:135 src/main.c:183
msgid "Performance profile changed"
msgstr "Kua huri te kōtaha mahi"

#: src/main.c:367
msgid "Balanced"
msgstr "Taurite"

#: src/main.c:615
msgid "Error changing profile"
msgstr "Hapa i te huri kōtaha"

#: src/main.c:615
msgid "Failed to set profile via ASUSD"
msgstr "Kāore i tautuhi te kōtaha mā ASUSD"

#: src/main.c:649
msgid "Battery and performance profile manager for ASUS laptops"
msgstr "Kaiwhakahaere pākahiko me ngā kōtaha mahi mō ngā rorohiko kawe ASUS"

#: src/main.c:699
msgid "Manage performance profile"
msgstr "Whakahaere kōtaha mahi"

#: src/settings-dialog.c:670
msgid "Power Profile Settings"
msgstr "Tautuhinga Kōtaha Hiko"

#: src/settings-dialog.c:690
msgid "Auto switch profiles"
msgstr "Whakawhiti kōtaha aunoa"

#: src/settings-dialog.c:699
msgid "On AC"
msgstr "I runga i te AC"

#: src/settings-dialog.c:744
msgid "On Battery"
msgstr "I runga i te pākahiko"

#: src/settings-dialog.c:790
msgid "Charge limit"
msgstr "Tepe utu"

#: src/settings-dialog.c:801
msgid "Limit to 80%"
msgstr "Tepe ki te 80%"

#: src/settings-dialog.c:809
msgid "Full charge once:"
msgstr "Utu kī tonu kotahi:"

#: src/settings-dialog.c:811
msgid "Start"
msgstr "Tīmata"

#: src/settings-dialog.c:816
msgid "Profile names and icons"
msgstr "Ingoa kōtaha me ngā tohu"

#: src/settings-dialog.c:864
msgid "icon name"
msgstr "ingoa tohu"

#: src/settings-dialog.c:874
msgid "Display options"
msgstr "Kōwhiringa whakaatu"

#: src/settings-dialog.c:885
msgid "Hide:"
msgstr "Huna:"

#: src/settings-dialog.c:888
msgid "Icon"
msgstr "Tohu"

#: src/settings-dialog.c:896
msgid "Text"
msgstr "Kuputuhi"

#: src/settings-dialog.c:909
msgid "Elements align:"
msgstr "Tīaroaro huānga:"

#: src/settings-dialog.c:913
msgid "Left"
msgstr "Mauī"

#: src/settings-dialog.c:914
msgid "Center"
msgstr "Pokapū"

#: src/settings-dialog.c:915
msgid "Right"
msgstr "Matau"

#: src/settings-dialog.c:927
msgid "Minimal width"
msgstr "Whānui iti"

#: src/settings-dialog.c:945
msgid "Right icon"
msgstr "Tohu i te matau"

#: src/settings-dialog.c:952
msgid "Notifications"
msgstr "Pānui"

#: src/settings-dialog.c:964
msgid "Hide notifications"
msgstr "Huna pānui"

#: src/settings-dialog.c:978
msgid "Anti-flapping"
msgstr "Ārai-kōwhā"

#: src/settings-dialog.c:986
msgid "Time:"
msgstr "Wā:"

#: src/settings-dialog.c:1009
msgid "ms"
msgstr "ms"

#: src/settings-dialog.c:1012 src/settings-dialog.c:1331
msgid "Value must be between 100 and 5000 ms"
msgstr "Me noho te uara i waenga i te 100 ki te 5000 ms"

#: src/settings-dialog.c:1030
msgid "Apply"
msgstr "Whakamahi"

#: src/settings-dialog.c:1034
msgid "Close"
msgstr "Kati"

#: src/settings-dialog.c:1294
#, c-format
msgid ""
"Charge battery to 100%% once?\n"
"\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr ""
"Utu te pākahiko ki te 100%% kotahi?\n"
"\n"
"Ka whakakorengia te tepe utu 80%% mō te wā poto.\n"
"Ka whakahokia te tepe i muri i te huringa utu e whai ake nei."

#: src/settings-dialog.c:1296
msgid "One-shot full charge"
msgstr "Utu kī tonu kotahi"

#: src/settings-dialog.c:1325
msgid "Please enter a number"
msgstr "Tēnā, whakaurua he tau"

#: src/settings-dialog.c:1362 src/settings-dialog.c:1588
msgid "No changes"
msgstr "Karekau he panoni"

#: src/settings-dialog.c:1362 src/settings-dialog.c:1588
msgid "Settings are already up to date"
msgstr "Kua whakahoutia kē ngā tautuhinga"

#: src/settings-dialog.c:1513
msgid "Invalid value"
msgstr "Uara muhu"

#: src/settings-dialog.c:1514
msgid "Timeout must be between 100 and 5000 ms"
msgstr "Me noho te wātatari i waenga i te 100 ki te 5000 ms"

#: src/settings-dialog.c:1547 src/settings-dialog.c:1591
#: src/settings-dialog.c:1790
msgid "Settings applied"
msgstr "Kua whakamahia ngā tautuhinga"

#: src/settings-dialog.c:1547 src/settings-dialog.c:1591
msgid "UI settings updated"
msgstr "Kua whakahoutia ngā tautuhinga UI"

#: src/settings-dialog.c:1555
msgid "ASUSD is not available. Cannot apply settings."
msgstr "Kāore e wātea ana ASUSD. Kāore e taea te whakamahi tautuhinga."

#: src/settings-dialog.c:1774
msgid "Error applying settings"
msgstr "Hapa i te whakamahi tautuhinga"

#: src/settings-dialog.c:1775
msgid "Some settings could not be applied."
msgstr "Kāore i taea te whakamahi ētahi tautuhinga."

#: src/settings-dialog.c:1790
msgid "Power profile settings have been updated"
msgstr "Kua whakahoutia ngā tautuhinga kōtaha hiko"
