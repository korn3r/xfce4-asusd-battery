#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Управление профилем производительности"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD недоступен"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Пожалуйста, установите asusd для управления профилями питания"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Настройки профиля питания"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Закрыть"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Автопереключение профилей"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "От сети"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "От батареи"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Имена и иконки профилей"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Скрыть иконку"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Скрыть текст"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Пользовательское имя"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Имя иконки"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Настройки"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "О программе"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "О плагине ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Версия 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Плагин для управления профилями питания ноутбуков ASUS через asusd.\n"
"Позволяет переключаться между режимами производительности, сбалансированным и тихим.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Ограничить заряд батареи до 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Однократная полная зарядка"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Запустить"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Зарядить батарею до 100% однократно, игнорируя лимит 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Зарядить батарею до 100%% однократно?\n\n"
"Это временно отключит лимит заряда 80%%.\n"
"Лимит будет восстановлен после следующего цикла зарядки."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Не удалось запустить однократную полную зарядку:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Однократная полная зарядка запущена.\n\nБатарея зарядится до 100%% один раз."

