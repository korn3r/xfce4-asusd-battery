msgid "Custom name"
msgstr "اسم مخصص"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "اسم الأيقونة"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "الإعدادات"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "حول"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "حول إضافة ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "الإصدار 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>إضافة لإدارة ملفات تعريف الطاقة لأجهزة ASUS المحمولة عبر asusd.\n"
"تسمح بالتبديل بين أوضاع الأداء والمتوازن والهادئ.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "تحديد شحن البطارية إلى 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "شحن كامل لمرة واحدة"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "بدء"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "شحن البطارية إلى 100% مرة واحدة، مع تجاهل حد 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "هل تريد شحن البطارية إلى 100%% مرة واحدة؟\n\n"
"سيؤدي هذا إلى تجاوز حد الشحن 80%% مؤقتًا.\n"
"سيتم استعادة الحد بعد دورة الشحن التالية."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "فشل بدء الشحن الكامل لمرة واحدة:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "بدأ الشحن الكامل لمرة واحدة.\n\nسيتم شحن البطارية إلى 100%% مرة واحدة."

