#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Administrer ydeevneprofil"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD ikke tilgængelig"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Installer asusd for at administrere strømprofiler"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Indstillinger for strømprofil"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Luk"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Automatisk skift af profiler"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "På netstrøm"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "På batteri"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Profilnavne og ikoner"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Skjul ikon"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Skjul tekst"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Brugerdefineret navn"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Ikonnavn"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Indstillinger"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Om"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Om ASUS Battery-plugin"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Version 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin til styring af ASUS bærbare strømprofiler via asusd.\n"
"Gør det muligt at skifte mellem ydelse, afbalanceret og stille tilstande.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Begræns batteriopladning til 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Engangsfull opladning"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Start"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Oplad batteriet til 100% én gang, ignorer 80% begrænsningen"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Oplad batteriet til 100%% én gang?\n\n"
"Dette vil midlertidigt tilsidesætte 80%% opladningsgrænsen.\n"
"Grænsen vil blive gendannet efter næste opladningscyklus."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Kunne ikke starte engangsfull opladning:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Engangsfull opladning startet.\n\nBatteriet vil blive opladet til 100%% én gang."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Administrer ASUS bærbare strømprofiler via asusd"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>Forfattere:</b> Deepseek og korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "Luk"

