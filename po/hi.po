#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "प्रदर्शन प्रोफ़ाइल प्रबंधित करें"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD उपलब्ध नहीं है"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "पावर प्रोफाइल प्रबंधित करने के लिए कृपया asusd स्थापित करें"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "पावर प्रोफ़ाइल सेटिंग्स"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_बंद करें"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "स्वचालित प्रोफ़ाइल स्विचिंग"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "एसी पर"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "बैटरी पर"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "प्रोफ़ाइल नाम और आइकन"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "आइकन छिपाएं"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "टेक्स्ट छिपाएं"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "कस्टम नाम"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "आइकन नाम"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "सेटिंग्स"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "के बारे में"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "ASUS बैटरी प्लगइन के बारे में"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "संस्करण 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>asusd के माध्यम से ASUS लैपटॉप पावर प्रोफाइल प्रबंधित करने के लिए प्लगइन।\n"
"प्रदर्शन, संतुलित और शांत मोड के बीच स्विचिंग की अनुमति देता है।</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "बैटरी चार्ज को 80% तक सीमित करें"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "एक बार पूर्ण चार्ज"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "प्रारंभ करें"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "बैटरी को एक बार 100% तक चार्ज करें, 80% की सीमा को अनदेखा करें"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "क्या बैटरी को एक बार 100%% तक चार्ज करें?\n\n"
"यह 80%% चार्ज सीमा को अस्थायी रूप से ओवरराइड करेगा।\n"
"सीमा अगले चार्ज चक्र के बाद बहाल हो जाएगी।"

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "एक बार पूर्ण चार्ज प्रारंभ करने में विफल:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "एक बार पूर्ण चार्ज प्रारंभ किया गया।\n\nबैटरी एक बार 100%% तक चार्ज होगी।"

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS बैटरी"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "asusd के माध्यम से ASUS लैपटॉप पावर प्रोफाइल प्रबंधित करें"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS बैटरी</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>लेखक:</b> Deepseek और korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "बंद करें"

#: xfce4-asusd-battery.c
msgid "xfce4-asusd-battery"
msgstr "xfce4-asusd-battery"
