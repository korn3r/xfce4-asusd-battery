#: src/settings-dialog.c:1294
#, c-format
msgid ""
"Charge battery to 100%% once?\n"
"\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr ""
"बैटरी को एक बार 100%% तक चार्ज करें?\n"
"\n"
"यह अस्थायी रूप से 80%% चार्ज सीमा को ओवरराइड करेगा।\n"
"सीमा अगले चार्ज चक्र के बाद बहाल हो जाएगी।"

#: src/settings-dialog.c:1296
msgid "One-shot full charge"
msgstr "एक बार पूर्ण चार्ज"

#: src/settings-dialog.c:1325
msgid "Please enter a number"
msgstr "कृपया एक संख्या दर्ज करें"

#: src/settings-dialog.c:1362 src/settings-dialog.c:1588
msgid "No changes"
msgstr "कोई परिवर्तन नहीं"

#: src/settings-dialog.c:1362 src/settings-dialog.c:1588
msgid "Settings are already up to date"
msgstr "सेटिंग्स पहले से ही अद्यतित हैं"

#: src/settings-dialog.c:1513
msgid "Invalid value"
msgstr "अमान्य मान"

#: src/settings-dialog.c:1514
msgid "Timeout must be between 100 and 5000 ms"
msgstr "टाइमआउट 100 से 5000 मि॰से॰ के बीच होना चाहिए"

#: src/settings-dialog.c:1547 src/settings-dialog.c:1591
#: src/settings-dialog.c:1790
msgid "Settings applied"
msgstr "सेटिंग्स लागू की गईं"

#: src/settings-dialog.c:1547 src/settings-dialog.c:1591
msgid "UI settings updated"
msgstr "यूआई सेटिंग्स अद्यतित की गईं"

#: src/settings-dialog.c:1555
msgid "ASUSD is not available. Cannot apply settings."
msgstr "ASUSD उपलब्ध नहीं है। सेटिंग्स लागू नहीं की जा सकतीं।"

#: src/settings-dialog.c:1774
msgid "Error applying settings"
msgstr "सेटिंग्स लागू करने में त्रुटि"

#: src/settings-dialog.c:1775
msgid "Some settings could not be applied."
msgstr "कुछ सेटिंग्स लागू नहीं की जा सकीं।"

#: src/settings-dialog.c:1790
msgid "Power profile settings have been updated"
msgstr "पावर प्रोफ़ाइल सेटिंग्स अद्यतित की गईं"
