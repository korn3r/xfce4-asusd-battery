#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Gérer le profil de performance"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD non disponible"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Veuillez installer asusd pour gérer les profils d'alimentation"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Paramètres du profil d'alimentation"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Fermer"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Changement automatique des profils"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Sur secteur"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Sur batterie"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Noms et icônes des profils"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Masquer l'icône"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Masquer le texte"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Nom personnalisé"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Nom de l'icône"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Paramètres"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "À propos"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "À propos du plugin ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Version 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin pour gérer les profils d'alimentation des ordinateurs portables ASUS via asusd.\n"
"Permet de basculer entre les modes performance, équilibré et silencieux.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Limiter la charge de la batterie à 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Charge complète unique"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Démarrer"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Charger la batterie à 100% une fois, en ignorant la limite de 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Charger la batterie à 100%% une fois?\n\n"
"Cela outrepassera temporairement la limite de charge de 80%%.\n"
"La limite sera rétablie après le prochain cycle de charge."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Échec du démarrage de la charge complète unique:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Charge complète unique démarrée.\n\nLa batterie sera chargée à 100%% une fois."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Gérer les profils d'alimentation des ordinateurs portables ASUS via asusd"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>Auteurs:</b> Deepseek et korn3r</small>"

