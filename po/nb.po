#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Administrer ytelsesprofil"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD ikke tilgjengelig"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Installer asusd for å administrere strømprofiler"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Innstillinger for strømprofil"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Lukk"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Automatisk bytte av profiler"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "På nettstrøm"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "På batteri"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Profilnavn og ikoner"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Skjul ikon"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Skjul tekst"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Tilpasset navn"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Ikonnavn"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Innstillinger"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Om"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Om ASUS Battery-plugin"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Versjon 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin for å administrere ASUS bærbare strømprofiler via asusd.\n"
"Gjør det mulig å bytte mellom ytelse, balansert og stillegående moduser.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Begrens batterilading til 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Engangsfull lading"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Start"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Lad batteriet til 100% én gang, ignorer 80%-grensen"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Lad batteriet til 100%% én gang?\n\n"
"Dette vil midlertidig overstyre 80%% ladningsgrensen.\n"
"Grensen vil bli gjenopprettet etter neste ladningssyklus."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Kunne ikke starte engangsfull lading:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Engangsfull lading startet.\n\nBatteriet vil bli ladet til 100%% én gang."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Administrer ASUS bærbare strømprofiler via asusd"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>Forfattere:</b> Deepseek og korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "Lukk"

