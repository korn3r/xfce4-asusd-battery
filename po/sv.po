#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Hantera prestandaprofil"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD inte tillgänglig"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Installera asusd för att hantera strömprofiler"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Inställningar för strömprofil"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Stäng"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Automatiskt växla profiler"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "På nätström"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "På batteri"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Profilnamn och ikoner"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Dölj ikon"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Dölj text"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Anpassat namn"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Ikonnamn"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Inställningar"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Om"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Om ASUS Battery-plugin"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Version 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin för att hantera ASUS bärbara datorers strömprofiler via asusd.\n"
"Möjliggör växling mellan prestanda, balanserade och tysta lägen.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Begränsa batteriladdning till 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Engångsfull laddning"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Starta"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Ladda batteriet till 100% en gång, ignorera 80%-gränsen"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Ladda batteriet till 100%% en gång?\n\n"
"Detta kommer tillfälligt att åsidosätta 80%% laddningsgränsen.\n"
"Gränsen återställs efter nästa laddningscykel."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Misslyckades att starta engångsfull laddning:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Engångsfull laddning startad.\n\nBatteriet kommer att laddas till 100%% en gång."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Hantera ASUS bärbara datorers strömprofiler via asusd"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>Författare:</b> Deepseek och korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "Stäng"

