#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "مدیریت پروفایل عملکرد"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD در دسترس نیست"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "لطفاً asusd را برای مدیریت پروفایل‌های برق نصب کنید"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "تنظیمات پروفایل برق"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_بستن"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "تعویض خودکار پروفایل‌ها"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "روی برق"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "روی باتری"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "نام‌ها و آیکون‌های پروفایل"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "مخفی کردن آیکون"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "مخفی کردن متن"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "نام سفارشی"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "نام آیکون"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "تنظیمات"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "درباره"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "درباره افزونه ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "نسخه 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>افزونه برای مدیریت پروفایل‌های برق لپ‌تاپ‌های ASUS از طریق asusd.\n"
"امکان تعویض بین حالت‌های عملکرد، متعادل و بی‌صدا را فراهم می‌کند.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "محدود کردن شارژ باتری به ۸۰٪"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "شارژ کامل یک‌باره"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "شروع"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "باتری را یک بار تا ۱۰۰٪ شارژ کنید، با نادیده گرفتن محدودیت ۸۰٪"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "آیا باتری را یک بار تا ۱۰۰%% شارژ کنیم؟\n\n"
"این کار به طور موقت محدودیت شارژ ۸۰%% را لغو می‌کند.\n"
"محدودیت پس از چرخه شارژ بعدی بازگردانده می‌شود."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "شروع شارژ کامل یک‌باره ناموفق بود:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "شارژ کامل یک‌باره آغاز شد.\n\nباتری یک بار تا ۱۰۰%% شارژ خواهد شد."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "مدیریت پروفایل‌های برق لپ‌تاپ‌های ASUS از طریق asusd"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>نویسندگان:</b> Deepseek و korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "بستن"

