msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Кіраванне профілямі харчавання ноўтбукаў ASUS праз asusd"

