msgstr "Не ўдалося запусціць аднаразовую поўную зарадку"

#: src/asusd-client.c:1389
msgid "One-shot full charge started"
msgstr "Аднаразовая поўная зарадка запушчана"

#: src/asusd-client.c:1389
#, c-format
msgid "The battery will charge to 100% once."
msgstr "Батарэя будзе зараджана да 100% адзін раз."

#: src/main.c:134 src/main.c:182
#, c-format
msgid "Current profile: %s"
msgstr "Бягучы профіль: %s"

#: src/main.c:135 src/main.c:183
