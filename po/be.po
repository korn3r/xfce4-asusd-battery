#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Кіраваць профілем прадукцыйнасці"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD недаступны"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Калі ласка, усталюйце asusd для кіравання профілямі харчавання"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Налады профіля харчавання"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Закрыць"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Аўтаматычнае пераключэнне профіляў"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Ад сеткі"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Ад батарэі"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Назвы і абразкі профіляў"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Схаваць абразок"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Схаваць тэкст"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Карыстацкая назва"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Назва абразка"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Налады"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Аб праграме"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Аб плагіне ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Версія 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Плагін для кіравання профілямі харчавання ноўтбукаў ASUS праз asusd.\n"
"Дазваляе пераключацца паміж рэжымамі прадукцыйнасці, збалансаваным і ціхім.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Абмежаваць зарад батарэі да 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Аднаразовы поўны зарад"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Запусціць"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Зарадзіць батарэю да 100% адзін раз, ігнаруючы ліміт 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Зарадзіць батарэю да 100%% адзін раз?\n\n"
"Гэта часова адключыць ліміт зараду 80%%.\n"
"Ліміт будзе адноўлены пасля наступнага цыкла зараду."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Не атрымалася запусціць аднаразовы поўны зарад:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Аднаразовы поўны зарад запушчаны.\n\nБатарэя зарадзіцца да 100%% адзін раз."

