#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Gestionar perfil de rendimiento"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD no disponible"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Instale asusd para gestionar los perfiles de energía"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Configuración de perfiles de energía"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Cerrar"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Cambio automático de perfiles"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Con corriente"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Con batería"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Nombres e iconos de perfiles"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Ocultar icono"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Ocultar texto"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Nombre personalizado"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Nombre del icono"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Configuración"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Acerca de"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Acerca del plugin ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Versión 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin para gestionar perfiles de energía de portátiles ASUS mediante asusd.\n"
"Permite cambiar entre los modos rendimiento, equilibrado y silencioso.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Limitar carga de batería al 80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Carga completa única"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Iniciar"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Cargar batería al 100% una vez, ignorando el límite del 80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "¿Cargar batería al 100%% una vez?\n\n"
"Esto anulará temporalmente el límite de carga del 80%%.\n"
"El límite se restaurará después del próximo ciclo de carga."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Error al iniciar la carga completa única:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Carga completa única iniciada.\n\nLa batería se cargará al 100%% una vez."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Gestionar perfiles de energía de portátiles ASUS mediante asusd"

