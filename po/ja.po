msgid "Manage performance profile"
msgstr "パフォーマンスプロファイルを管理"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSDが利用できません"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "電源プロファイルを管理するにはasusdをインストールしてください"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "電源プロファイル設定"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_閉じる"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "プロファイル自動切替"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "AC電源"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "バッテリー駆動"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "プロファイル名とアイコン"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "アイコンを隠す"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "テキストを隠す"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "カスタム名"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "アイコン名"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "設定"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "情報"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "ASUS Battery プラグインについて"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "バージョン 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>asusdを使用してASUSラップトップの電源プロファイルを管理するプラグイン。\n"
"パフォーマンス、バランス、静音モード間の切り替えが可能です。</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "バッテリー充電を80%に制限"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "一回限りのフル充電"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "開始"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "バッテリーを一回だけ100%まで充電し、80%制限を無視"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "バッテリーを一回だけ100%%まで充電しますか？\n\n"
"これにより80%%の充電制限が一時的に解除されます。\n"
"制限は次の充電サイクル後に復元されます。"

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "一回限りのフル充電の開始に失敗しました:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "一回限りのフル充電が開始されました。\n\nバッテリーが一回だけ100%%まで充電されます。"

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
