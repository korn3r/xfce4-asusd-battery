#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Hallitse suorituskykyprofiilia"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD ei ole käytettävissä"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Asenna asusd hallitaksesi virranhallintaprofiileja"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Virranhallintaprofiilin asetukset"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Sulje"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Automaattinen profiilien vaihto"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Verkkovirralla"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Akulla"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Profiilien nimet ja kuvakkeet"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Piilota kuvake"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Piilota teksti"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Mukautettu nimi"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Kuvakkeen nimi"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Asetukset"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Tietoja"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Tietoja ASUS Battery -laajennuksesta"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Versio 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Laajennus ASUS-kannettavien virranhallintaprofiilien hallintaan asusd:n kautta.\n"
"Mahdollistaa vaihtamisen suorituskyky-, tasapaino- ja hiljainen-tilojen välillä.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Rajoita akun lataus 80%:iin"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Kertalataus täyteen"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Käynnistä"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Lataa akku kerran 100%:iin ohittaen 80%:n rajoituksen"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Ladataanko akku kerran 100%%:iin?\n\n"
"Tämä ohittaa väliaikaisesti 80%%:n latausrajoituksen.\n"
"Rajoitus palautuu seuraavan latausjakson jälkeen."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Kertalatauksen käynnistäminen epäonnistui:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Kertalataus käynnistetty.\n\nAkku latautuu kerran 100%%:iin."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Hallitse ASUS-kannettavien virranhallintaprofiileja asusd:n kautta"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>Tekijät:</b> Deepseek ja korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "Sulje"

