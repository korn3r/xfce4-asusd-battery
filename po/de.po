msgstr "_Schließen"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Profile automatisch wechseln"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Am Netz"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Im Akkubetrieb"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Profilnamen und -symbole"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Symbol ausblenden"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Text ausblenden"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Benutzerdefinierter Name"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Symbolname"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Einstellungen"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Über"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Über ASUS Battery Plugin"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Version 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin zur Verwaltung von ASUS-Laptop-Stromprofilen über asusd.\n"
"Ermöglicht das Umschalten zwischen den Modi Leistung, Ausgewogen und Leise.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Akkuladung auf 80% begrenzen"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Einmalige Vollladung"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Starten"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Akkuladung einmal auf 100% laden, unter Umgehung der 80%-Grenze"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Akkuladung einmal auf 100%% laden?\n\n"
"Dies wird die 80%%-Ladegrenze vorübergehend außer Kraft setzen.\n"
"Die Grenze wird nach dem nächsten Ladezyklus wiederhergestellt."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Fehler beim Starten der einmaligen Vollladung:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Einmalige Vollladung gestartet.\n\nDer Akku wird einmal auf 100%% geladen."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "ASUS-Laptop-Stromprofile über asusd verwalten"

