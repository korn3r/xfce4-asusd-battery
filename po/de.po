#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Leistungsprofil verwalten"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD nicht verfügbar"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Bitte installieren Sie asusd zur Verwaltung der Stromprofile"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Stromprofileinstellungen"

#: xfce4-asusd-battery.c
