#: xfce4-asusd-battery.c
msgid "Manage performance profile"
msgstr "Gestisci profilo prestazioni"

#: xfce4-asusd-battery.c
msgid "ASUSD not available"
msgstr "ASUSD non disponibile"

#: xfce4-asusd-battery.c
msgid "Please install asusd to manage power profiles"
msgstr "Installare asusd per gestire i profili di alimentazione"

#: xfce4-asusd-battery.c
msgid "Power Profile Settings"
msgstr "Impostazioni profilo alimentazione"

#: xfce4-asusd-battery.c
msgid "_Close"
msgstr "_Chiudi"

#: xfce4-asusd-battery.c
msgid "Auto switch profiles"
msgstr "Cambio automatico profili"

#: xfce4-asusd-battery.c
msgid "On AC"
msgstr "Da rete"

#: xfce4-asusd-battery.c
msgid "On Battery"
msgstr "Da batteria"

#: xfce4-asusd-battery.c
msgid "Profile names and icons"
msgstr "Nomi e icone dei profili"

#: xfce4-asusd-battery.c
msgid "Hide icon"
msgstr "Nascondi icona"

#: xfce4-asusd-battery.c
msgid "Hide text"
msgstr "Nascondi testo"

#: xfce4-asusd-battery.c
msgid "Custom name"
msgstr "Nome personalizzato"

#: xfce4-asusd-battery.c
msgid "Icon name"
msgstr "Nome icona"

#: xfce4-asusd-battery.c
msgid "Settings"
msgstr "Impostazioni"

#: xfce4-asusd-battery.c
msgid "About"
msgstr "Informazioni"

#: xfce4-asusd-battery.c
msgid "About ASUS Battery Plugin"
msgstr "Informazioni sul plugin ASUS Battery"

#: xfce4-asusd-battery.c
msgid "Version 1.0"
msgstr "Versione 1.0"

#: xfce4-asusd-battery.c
msgid "<small>Plugin for managing ASUS laptop power profiles via asusd.\n"
"Allows switching between performance, balanced and quiet modes.</small>"
msgstr "<small>Plugin per gestire i profili di alimentazione dei portatili ASUS tramite asusd.\n"
"Consente di passare tra le modalità prestazioni, bilanciata e silenziosa.</small>"

#: xfce4-asusd-battery.c
msgid "Limit battery charge to 80%"
msgstr "Limita carica batteria all'80%"

#: xfce4-asusd-battery.c
msgid "One-shot full charge"
msgstr "Carica completa una tantum"

#: xfce4-asusd-battery.c
msgid "Start"
msgstr "Avvia"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100% once, ignoring the 80% limit"
msgstr "Carica la batteria al 100% una volta, ignorando il limite dell'80%"

#: xfce4-asusd-battery.c
msgid "Charge battery to 100%% once?\n\n"
"This will temporarily override the 80%% charge limit.\n"
"The limit will be restored after the next charge cycle."
msgstr "Caricare la batteria al 100%% una volta?\n\n"
"Questo sovrascriverà temporaneamente il limite di carica dell'80%%.\n"
"Il limite verrà ripristinato dopo il prossimo ciclo di carica."

#: xfce4-asusd-battery.c
msgid "Failed to start one-shot full charge:\n%s"
msgstr "Impossibile avviare la carica completa una tantum:\n%s"

#: xfce4-asusd-battery.c
msgid "One-shot full charge started.\n\nThe battery will charge to 100%% once."
msgstr "Carica completa una tantum avviata.\n\nLa batteria verrà caricata al 100%% una volta."

#: xfce4-asusd-battery.desktop.in
msgid "ASUS Battery"
msgstr "ASUS Battery"

#: xfce4-asusd-battery.desktop.in
msgid "Manage ASUS laptop power profiles via asusd"
msgstr "Gestisci i profili di alimentazione dei portatili ASUS tramite asusd"

#: xfce4-asusd-battery.c
msgid "<b>ASUS Battery</b>"
msgstr "<b>ASUS Battery</b>"

#: xfce4-asusd-battery.c
msgid "<small><b>Authors:</b> Deepseek and korn3r</small>"
msgstr "<small><b>Autori:</b> Deepseek e korn3r</small>"

#: xfce4-asusd-battery.c
msgid "Close"
msgstr "Chiudi"

